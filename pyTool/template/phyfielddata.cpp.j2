#include "{{field.fieldDataClassName}}.h"
#include "{{femDataClassName}}.h"
{% for ele in field.eleSubs %}
#include "{{ele.name}}.h"
{% endfor %}

{{field.fieldDataClassName}}::{{field.fieldDataClassName}}(CDFEG::DomainData* femData)
    : CDFEG::PhyFieldData({{field.dof}}, femData) {
    _name="{{field.name}}";
    _dispNames = { {% for disp in field.dispNames %}"{{disp}}"{% if not loop.last %}, {% endif %}{% endfor %} };
    _dof2 = {{field.dof}};
{% for ele in field.eleSubs %}
    _eleSubs.push_back(new {{ele.name}}(this));
{% endfor %}
    _eleResNames = { {% for res in field.eleResNames %}"{{res}}"{% if not loop.last %}, {% endif %}{% endfor %} };
{% if field.bNodeExtrap %}
    _nodeExtrapNames = { {% for n in (field.nodeExtrapNames if field.nodeExtrapNames else field.eleResNames) %}"{{n}}"{% if not loop.last %}, {% endif %}{% endfor %} };
{% endif %}
}

{{field.fieldDataClassName}}::~{{field.fieldDataClassName}}() {

}

